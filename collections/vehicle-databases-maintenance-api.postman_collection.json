                  "disabled": false,
                  "key": "mileage",
                  "value": "<integer>",
                  "description": "Current vehicle mileage to filter upcoming services"
                },
                {
                  "disabled": false,
                  "key": "includeItems",
                  "value": "true",
                  "description": "Include detailed service items in response"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "vehicleId",
                  "description": "(Required) Vehicle identifier from lookup or VIN decode"
