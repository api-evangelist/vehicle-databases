{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vehicle Databases Maintenance API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Vehicles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Vehicle Databases Lookup Vehicle",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vehicledatabases.com/v1/vehicle",
            "params": [
              {
                "name": "make",
                "value": "Toyota",
                "type": "query",
                "description": "Vehicle make (e.g. Toyota, Ford, Chevrolet)"
              },
              {
                "name": "model",
                "value": "Camry",
                "type": "query",
                "description": "Vehicle model (e.g. Camry, F-150)"
              },
              {
                "name": "year",
                "value": "2022",
                "type": "query",
                "description": "4-digit model year"
              }
            ]
          },
          "docs": "Look up vehicle information by make, model, and year. Returns available engine options, trim levels, and vehicle identifiers for use in subsequent maintenance schedule and service lookups."
        },
        {
          "info": {
            "name": "Vehicle Databases Decode VIN",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vehicledatabases.com/v1/vin/:vin",
            "params": [
              {
                "name": "vin",
                "value": "4T1C11AK2NU123456",
                "type": "path",
                "description": "17-character Vehicle Identification Number"
              }
            ]
          },
          "docs": "Decode a 17-character Vehicle Identification Number (VIN) to extract make, model, year, engine, body style, trim, transmission, drive type, and plant of manufacture."
        }
      ]
    },
    {
      "info": {
        "name": "Maintenance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Vehicle Databases Get Maintenance Schedule",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vehicledatabases.com/v1/maintenance/:vehicleId",
            "params": [
              {
                "name": "vehicleId",
                "value": "toyota-camry-2022-25l-4cyl",
                "type": "path",
                "description": "Vehicle identifier from lookup or VIN decode"
              },
              {
                "name": "mileage",
                "value": "45000",
                "type": "query",
                "description": "Current vehicle mileage to filter upcoming services"
              },
              {
                "name": "includeItems",
                "value": "",
                "type": "query",
                "description": "Include detailed service items in response"
              }
            ]
          },
          "docs": "Returns the complete OEM-compliant maintenance schedule for a vehicle, including all service intervals from 5,000 to 200,000 miles with service items, fluids, and estimated costs for each interval."
        }
      ]
    },
    {
      "info": {
        "name": "Services",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Vehicle Databases List Service Items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vehicledatabases.com/v1/services/:vehicleId",
            "params": [
              {
                "name": "vehicleId",
                "value": "toyota-camry-2022-25l-4cyl",
                "type": "path",
                "description": "Vehicle identifier"
              },
              {
                "name": "mileage",
                "value": "50000",
                "type": "query",
                "description": "Service interval mileage"
              }
            ]
          },
          "docs": "Returns all service items for a vehicle at a specific mileage interval, including fluid specifications, part numbers, labor time estimates, and OEM-required procedures."
        }
      ]
    },
    {
      "info": {
        "name": "Recalls",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Vehicle Databases Get Recalls",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vehicledatabases.com/v1/recalls/:vehicleId",
            "params": [
              {
                "name": "vehicleId",
                "value": "toyota-camry-2022-25l-4cyl",
                "type": "path",
                "description": "Vehicle identifier"
              }
            ]
          },
          "docs": "Returns NHTSA safety recall information for a specific vehicle including recall dates, components affected, risk descriptions, and remedy status."
        }
      ]
    },
    {
      "info": {
        "name": "TSBs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Vehicle Databases Get TSBs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.vehicledatabases.com/v1/tsb/:vehicleId",
            "params": [
              {
                "name": "vehicleId",
                "value": "toyota-camry-2022-25l-4cyl",
                "type": "path",
                "description": "Vehicle identifier"
              },
              {
                "name": "category",
                "value": "",
                "type": "query",
                "description": "TSB category filter (e.g. Engine, Electrical, HVAC)"
              }
            ]
          },
          "docs": "Returns technical service bulletins (TSBs) issued by the OEM for a specific vehicle, including symptoms, diagnosis procedures, and corrective actions."
        }
      ]
    }
  ],
  "bundled": true
}